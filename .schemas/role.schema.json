{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YAML schema for AWS IAM roles",
  "oneOf": [
    {
      "$ref": "#/$defs/githubRole"
    },
    {
      "$ref": "#/$defs/assumeRole"
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matcher": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "variable": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "matcher",
        "values",
        "variable"
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sid": {
          "type": "string"
        },
        "effect": {
          "type": "string",
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[A-Za-z0-9*]+$"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "default": []
        }
      },
      "required": [
        "sid",
        "effect",
        "actions",
        "resources"
      ]
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "githubRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "matcher": {
          "type": "string",
          "enum": [
            "StringEquals",
            "StringLike"
          ]
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "policies": {
          "$ref": "#/$defs/policies"
        }
      },
      "required": [
        "name",
        "repositories",
        "matcher",
        "policies"
      ]
    },
    "assumeRoleTrust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "default": []
        }
      },
      "required": [
        "principals"
      ]
    },
    "assumeRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "assume_role": {
          "$ref": "#/$defs/assumeRoleTrust"
        },
        "policies": {
          "$ref": "#/$defs/policies"
        }
      },
      "required": [
        "name",
        "assume_role",
        "policies"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+=,.@_-]+$"
        },
        "statements": {
          "$ref": "#/$defs/statements"
        }
      },
      "required": [
        "name",
        "statements"
      ]
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/policy"
      },
      "maxProperties": 20
    }
  }
}
